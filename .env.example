# Directory containing the externally maintained repositories read by the host MCP process.
REPOS_DIR=/absolute/path/to/repositories

MYSQL_DATABASE=agent_platform
MYSQL_USER=agent
MYSQL_PASSWORD=agent
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_DSN=agent:agent@tcp(127.0.0.1:3306)/agent_platform?parseTime=true&charset=utf8mb4&loc=UTC
# Optional production role DSNs; each falls back to MYSQL_DSN for local development.
API_MYSQL_DSN=
WORKER_MYSQL_DSN=
MIGRATION_MYSQL_DSN=
MAINTENANCE_MYSQL_DSN=
REDIS_URL=redis://127.0.0.1:6379/0
LLM_BASE_URL=
LLM_API_KEY=
# Base64-encoded 32-byte key used only to encrypt provider-native reasoning
# replay state in durable checkpoints. Generate with: openssl rand -base64 32
REPLAY_ENCRYPTION_KEY=
# Production keyring JSON, for example {"2026-08":"<base64-32-byte-key>"}.
# REPLAY_ENCRYPTION_KEY remains a single-key local-development fallback.
REPLAY_ENCRYPTION_ACTIVE_KEY_ID=
REPLAY_ENCRYPTION_KEYS=
# Model identifier supported by the configured Gateway, for example gpt-4.1-mini.
LLM_MODEL=internal-default
WORKSPACE_MCP_URL=http://127.0.0.1:8081/mcp
WORKER_ID=worker-local
# Max concurrent Runs executed by one Worker process.
WORKER_CONCURRENCY=10

# Structured zap logs: JSON to stdout and daily rotating files under LOG_DIR.
# Use LOG_LEVEL=debug for message-path debug logs (API accept, Eino I/O, DB, SSE).
# ./scripts/ha/up.sh overlays LOG_LEVEL into the HA ConfigMap and restarts pods.
LOG_DIR=logs
LOG_LEVEL=info
LOG_MAX_AGE_DAYS=14

# Optional Docker build proxy. On macOS, scripts/up.sh defaults this to port 7890.
# Docker image pulls themselves use the Docker Desktop/Engine proxy configuration.
DOCKER_PROXY_URL=
DOCKER_ALL_PROXY_URL=

# Optional host dependency download proxy.
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=
NO_PROXY=127.0.0.1,localhost
